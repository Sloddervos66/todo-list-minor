@using TodoList.Components.Classes

<EditForm Model="@(_currentItem)" OnValidSubmit="@(HandleClick)">
    <DataAnnotationsValidator />
    
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label for="title" class="form-label">Title</label>
                    <InputText id="title"
                               class="form-control"
                               @bind-Value="_currentItem.Title" />
                    <ValidationMessage For="@(() => _currentItem.Title)"></ValidationMessage>
                </div>
                
                <div class="col-md-4">
                    <label for="when" class="form-label">When</label>
                    <InputDate id="when" 
                               class="form-control"
                               @bind-Value="_currentItem.When"/>
                    <ValidationMessage For="@(() => _currentItem.When)"/>
                </div>
                
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        Add
                    </button>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public EventCallback<Item> ItemAdded { get; set; }

    private Item _currentItem = new();
    
    private async Task HandleClick()
    {
        await ItemAdded.InvokeAsync(_currentItem);
        _currentItem = new();
    }
}