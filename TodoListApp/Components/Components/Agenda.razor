@using System.Globalization
@using TodoListApp.Classes
@using TodoListApp.Dtos

@implements IAsyncDisposable

<style>
    .agenda-container {
        max-height: 80vh;
        overflow-y: auto;
    }

    .agenda {
        position: relative;
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        overflow-x: auto;
    }

    .agenda-day {
        min-width: 150px;
        border-right: 1px solid var(--bs-border-color);
    }

    .agenda-day:last-child {
        border-right: 0;
    }

    .agenda-day-header {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 0.75rem;
        text-align: center;
        background: var(--bs-body-bg);
        border-bottom: 1px solid var(--bs-border-color);
    }

    .agenda-day.today .agenda-day-header {
        background-color: var(--bs-primary-bg-subtle);
        color: var(--bs-primary-text-emphasis);
        box-shadow: inset 0 -2px 0 var(--bs-primary);
    }

    .agenda-slots {
        position: relative;
    }

    .agenda-slot {
        display: flex;
        min-height: 60px;
        border-bottom: 1px solid var(--bs-border-color);
    }

    .agenda-time {
        width: 48px;
        flex-shrink: 0;
        padding: 0.35rem;
        font-size: 0.7rem;
        color: var(--bs-secondary-color);
        text-align: right;
    }

    .agenda-slot-content {
        flex: 1;
        position: relative;
        border-left: 1px solid var(--bs-border-color);
    }

    .agenda-day-body {
        position: relative;
    }

    .agenda-task-layer {
        position: absolute;
        left: 48px;
        right: 0;
        top: 0;
        bottom: 0;
        pointer-events: none;
    }

    .agenda-task {
        position: absolute;
        padding: 0.4rem 0.5rem;
        border-radius: 0.375rem;
        background: var(--bs-primary-bg-subtle);
        color: var(--bs-primary-text-emphasis);
        border-left: 3px solid var(--bs-primary);
        font-size: 0.8rem;
        overflow: hidden;

        z-index: 5;
        cursor: pointer;
        pointer-events: auto;

        transition: filter 0.15s ease, transform 0.15s ease;
    }

    .agenda-task:hover {
        filter: brightness(0.95);
        transform: translateY(-1px);
    }

    .current-time-line {
        position: absolute;
        left: 48px;
        right: 0;
        height: 2px;
        background-color: var(--bs-danger);
        z-index: 10;
        pointer-events: none;
    }

    .current-time-label {
        position: absolute;
        left: -48px;
        top: -9px;
        width: 44px;
        text-align: right;
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--bs-danger);
    }
</style>

<div class="card-border-0 shadow-sm">
    <div class="card-body p-0">
        
        <div class="d-flex justify-content-between align-items-center p-3 border-bottom">
            <div>
                <h4 class="mb-1">Your agenda</h4>
                <small class="text-muted">
                    @WeekStart.ToString("MMMM d") -
                    @WeekStart.AddDays(6).ToString("MMMM d, yyyy")
                </small>
            </div>
            
            <div class="btn-group">
                <button class="btn btn-success" @onclick="OpenCreateDialog">
                    <i class="bi bi-plus-lg me-1"></i>
                    Add Task
                </button>
                
                <button class="btn btn-outline-secondary" @onclick="PreviousWeekAsync">
                    <i class="bi bi-chevron-left"></i>
                </button>

                <button class="btn btn-primary" @onclick="GoToTodayAsync">
                    Today
                </button>

                <button class="btn btn-outline-secondary" @onclick="NextWeekAsync">
                    <i class="bi bi-chevron-right"></i>
                </button>

                <form action="/logout" method="post">
                    <AntiforgeryToken />
                    
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-box-arrow-right me-1"></i>
                        Log out
                    </button>
                </form>
            </div>
        </div>
        
        <div class="agenda-container">
            <div class="agenda">
                @foreach (var day in Days)
                {
                    <div class="agenda-day @(day.Date == DateTime.Today ? "today" : "")">
                        <div class="agenda-day-header">
                            <div class="text-muted small">
                                @day.ToString("ddd")
                            </div>

                            <div class="fw-semibold">
                                @day.ToString("dd")
                            </div>
                        </div>

                        <div class="agenda-day-body">
                            @foreach (var hour in Hours)
                            {
                                <div class="agenda-slot"
                                     @oncontextmenu="() => OpenCreateDialog(day, hour)"
                                     @oncontextmenu:preventDefault>
                                    <span class="agenda-time">
                                        @hour:00
                                    </span>

                                    <div class="agenda-slot-content"></div>
                                </div>
                            }

                            <div class="agenda-task-layer">
                                @foreach (var taskLayout in GetTaskLayoutsForDay(day))
                                {
                                    <div class="agenda-task"
                                         style="@GetTaskStyle(taskLayout, day)"
                                         @onclick="() => OpenDialogTask(taskLayout.Task)"
                                         @onclick:stopPropagation
                                         @oncontextmenu:stopPropagation>
                                        @taskLayout.Task.Title
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                
                @if (Days.Any(day => day.Date == DateTime.Today))
                {
                    <div class="current-time-line"
                         style="@GetCurrentTimeStyle()">
                        <span class="current-time-label">
                            @CurrentTime.ToString("HH:mm")
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (_showCreateDialog)
{
    <CreateDialog InitialFrom="_createFrom"
                  OnSaved="TaskCreated"
                  OnCancelled="CloseCreateDialog"/>
}

@if (_selectedTask is not null)
{
    <TaskDialog @key="_selectedTask.Id" Task="_selectedTask" OnClosed="CloseTaskDialog" OnSaved="TaskSaved" OnDeleted="TaskDeleted" />
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TodoTaskDto> Tasks { get; set; } = [];
    [Parameter] public EventCallback<(DateTime From, DateTime To)> RangeChanged { get; set; }

    private const double PixelsPerHour = 60;
    private const double PixelsPerMinute = PixelsPerHour / 60;
    
    private DateTime WeekStart { get; set; } = GetStartOfWeek(DateTime.Today);
    private DateTime WeekEnd => WeekStart.AddDays(7);
    private IEnumerable<DateTime> Days => Enumerable.Range(0, 7).Select(i => WeekStart.AddDays(i));
    private IEnumerable<int> Hours => Enumerable.Range(0, 24);

    private DateTime CurrentTime { get; set; } = DateTime.Now;
    private readonly CancellationTokenSource _timerCancellation = new();
    private Task? _timerTask;
    
    private bool _showCreateDialog;
    private DateTime? _createFrom;
    
    private TodoTaskDto? _selectedTask;

    public async ValueTask DisposeAsync()
    {
        await _timerCancellation.CancelAsync();

        if (_timerTask is not null)
        {
            await _timerTask;
        }
        
        _timerCancellation.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _timerTask = UpdateCurrentTimeAsync();
        
        await NotifyRangeChanged();
    }

    private async Task UpdateCurrentTimeAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMinutes(1));

        try
        {
            while (await timer.WaitForNextTickAsync(_timerCancellation.Token))
            {
                CurrentTime = DateTime.Now;
                await InvokeAsync(StateHasChanged);
                
                var delay = TimeSpan.FromMinutes(1)
                            - TimeSpan.FromSeconds(CurrentTime.Second)
                            - TimeSpan.FromMilliseconds(CurrentTime.Millisecond);
                await Task.Delay(delay, _timerCancellation.Token);
            }
        }
        catch (OperationCanceledException)
        {
            // Component was disposed.
        }
    }

    private async Task PreviousWeekAsync()
    {
        WeekStart = WeekStart.AddDays(-7);
        await NotifyRangeChanged();
    }

    private async Task NextWeekAsync()
    {
        WeekStart = WeekStart.AddDays(7);
        await NotifyRangeChanged();
    }

    private async Task GoToTodayAsync()
    {
        WeekStart = GetStartOfWeek(DateTime.Today);
        await NotifyRangeChanged();
    }

    private async Task NotifyRangeChanged()
    {
        await RangeChanged.InvokeAsync((WeekStart, WeekEnd));
    }

    private async Task TaskCreated()
    {
        CloseCreateDialog();
        await NotifyRangeChanged();
    }

    private IEnumerable<TodoTaskDto> GetTasksForHour(DateTime day, int hour)
    {
        var start = day.AddHours(hour);
        var end = start.AddHours(1);

        return Tasks.Where(t => t.From < end && t.To > start);
    }

    private void OpenCreateDialog()
    {
        _createFrom = null;
        _showCreateDialog = true;
    }

    private void CloseCreateDialog()
    {
        _showCreateDialog = false;
        _createFrom = null;
    }

    private void OpenCreateDialog(DateTime day, int hour)
    {
        _createFrom = day.Date.AddHours(hour);
        _showCreateDialog = true;
    }

    private void OpenDialogTask(TodoTaskDto task)
    {
        _selectedTask = task;
        Console.WriteLine($"Clicked task: {task.Title}");
    }

    private async Task TaskSaved()
    {
        CloseTaskDialog();
        await NotifyRangeChanged();
    }

    private async Task TaskDeleted()
    {
        CloseTaskDialog();
        await NotifyRangeChanged();
    }

    private void CloseTaskDialog()
    {
        _selectedTask = null;
    }

    private IEnumerable<TodoTaskDto> GetTasksForDay(DateTime day)
    {
        var dayStart = day.Date;
        var dayEnd = dayStart.AddDays(1);
        
        return Tasks.Where(t => t.From < dayEnd && t.To > dayStart);
    }

    private IEnumerable<TaskLayout> GetTaskLayoutsForDay(DateTime day)
    {
        var tasks = GetTasksForDay(day)
            .OrderBy(t => t.From)
            .ThenBy(t => t.To)
            .ToList();

        var layouts = new List<TaskLayout>();
        var columns = new List<TodoTaskDto>();

        foreach (var task in tasks)
        {
            var column = 0;
            while (column < columns.Count && columns[column].To > task.From)
                column++;

            if (column == columns.Count)
                columns.Add(task);
            else
                columns[column] = task;
            
            layouts.Add(new TaskLayout(task, column, 0));
        }
        
        var columnCount = columns.Count;

        return layouts.Select(x => x with
        {
            ColumnCount = columnCount
        });
    }
    
    private static double GetTaskTop(TodoTaskDto task, DateTime day)
    {
        var minutes = (task.From - day.Date).TotalMinutes;
        return minutes;
    }

    private static double GetTaskHeight(TodoTaskDto task)
    {
        return (task.To - task.From).TotalMinutes;
    }

    private static string GetTaskStyle(TaskLayout layout, DateTime day)
    {
        var top = GetTaskTop(layout.Task, day);
        var height = GetTaskHeight(layout.Task);
        
        var width = 100.0 / layout.ColumnCount;
        var left = width * layout.Column;

        return
            $"top: {top.ToString(CultureInfo.InvariantCulture)}px; " +
            $"height: {height.ToString(CultureInfo.InvariantCulture)}px; " +
            $"left: {left.ToString(CultureInfo.InvariantCulture)}%; " +
            $"width: {width.ToString(CultureInfo.InvariantCulture)}%;";
    }
    
    private static string GetCurrentTimeStyle()
    {
        var minutes = DateTime.Now.TimeOfDay.TotalMinutes;
        var top = minutes * PixelsPerMinute;

        return $"top: {top.ToString(CultureInfo.InvariantCulture)}px;";
    }
    
    private static DateTime GetStartOfWeek(DateTime date)
    {
        var diff = (7 + (date.DayOfWeek - DayOfWeek.Monday)) % 7;
        return date.Date.AddDays(-diff);
    }
}