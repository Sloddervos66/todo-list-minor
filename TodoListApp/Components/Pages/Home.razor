@page "/"

@using Microsoft.AspNetCore.Authorization
@using TodoListApp.Components.Components
@using TodoListApp.Dtos
@using TodoListApp.Services

@attribute [Authorize]

@inject ITodoTaskService TodoTaskService

<PageTitle>Home</PageTitle>

<Agenda Tasks="_tasks" RangeChanged="LoadTasks" />

@code {
    private IReadOnlyList<TodoTaskDto> _tasks = [];
    
    private async Task LoadTasks((DateTime From, DateTime To) range)
    {
        try
        {
            _tasks = await TodoTaskService.GetForUserAsync(range.From, range.To);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}