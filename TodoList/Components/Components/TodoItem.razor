@using TodoList.Components.Classes

<div class="card shadow-sm border-0 mb-3 @(Item.Completed ? "bg-success-subtle" : "")">
    <div class="card-body d-flex align-items-start gap-3">
        <div class="form-check mt-1">
            <input class="form-check-input"
                   type="checkbox"
                   @bind="@(Item.Completed)"
                   @bind:after="HandleCompletedChanged" />
        </div>
        
        <div class="flex-grow-1">
            <div class="d-flex justify-content-between align-items-start">
                <h5 class="card-title mb-1 @(Item.Completed ? "text-decoration-line-through text-muted" : "")">
                    @(Item.Title)
                </h5>
                
                <div class="btn-group btn-group-sm">
                    <span class="d-inline-block" style="cursor: not-allowed;">
                        <button type="button"
                                class="btn btn-secondary"
                                title="Edit"
                                disabled="@(Item.Completed)"
                                @onclick="HandleEdit">
                            <i class="bi bi-pencil"></i>
                        </button>
                    </span>

                    <button type="button"
                            class="btn btn-danger"
                            title="Delete"
                            @onclick="HandleDelete">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            </div>
            
            <small class="text-muted">
                <i class="bi bi-calendar3 me-1"></i>
                @Item.When.ToString("ddd, MMM d, yyyy")
            </small>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Item Item { get; set; }
    
    [Parameter]
    public EventCallback<Item> OnEdit { get; set; }
    
    [Parameter]
    public EventCallback<Item> OnDelete { get; set; }
    
    [Parameter]
    public EventCallback<Item> OnCompletedChanged { get; set; }

    private Task HandleEdit() => OnEdit.InvokeAsync(Item);
    private Task HandleDelete() => OnDelete.InvokeAsync(Item);
    private Task HandleCompletedChanged() => OnCompletedChanged.InvokeAsync(Item);
}